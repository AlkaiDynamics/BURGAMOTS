{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "burgamots-omega0-record.schema.json",
  "title": "BURGAMOTS frozen Omega0(theta) record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "version",
    "status",
    "source",
    "coordinate_convention",
    "units",
    "representation",
    "content_sha256",
    "outcome_independence"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"const": "FROZEN"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "locator", "acquired_at", "source_version"],
      "properties": {
        "citation": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "acquired_at": {"type": "string", "format": "date"},
        "source_version": {"type": "string", "minLength": 1}
      }
    },
    "coordinate_convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theta_definition", "frame"],
      "properties": {
        "theta_definition": {"const": "colatitude_radians_north_pole_zero"},
        "frame": {"type": "string", "minLength": 1}
      }
    },
    "units": {"type": "string", "minLength": 1},
    "representation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "theta", "omega", "interpolation"],
          "properties": {
            "type": {"const": "tabulated"},
            "theta": {"type": "array", "minItems": 2, "items": {"type": "number"}},
            "omega": {"type": "array", "minItems": 2, "items": {"type": "number"}},
            "interpolation": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "basis", "coefficients"],
          "properties": {
            "type": {"const": "coefficients"},
            "basis": {"type": "string", "minLength": 1},
            "coefficients": {"type": "array", "minItems": 1, "items": {"type": "number"}}
          }
        }
      ]
    },
    "validity": {"type": ["object", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["burgamots_response_used", "selection_basis"],
      "properties": {
        "burgamots_response_used": {"const": false},
        "selection_basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
