{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://alkai-dynamics.example/contracts/leakage-check.schema.json",
  "title":"LeakageCheck",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","id","type","status","details","evidenceRefs"],
  "properties":{
    "schemaVersion":{"type":"string"},"id":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},
    "status":{"enum":["PASS","FAIL","UNRESOLVED","NOT_APPLICABLE"]},"details":{"type":"string"},
    "evidenceRefs":{"type":"array","items":{"type":"string"}}
  }
}
